# LUNAVIA — Frontend environment (example).
# Copy this file to `frontend/.env` and fill in real values.

# --- Backend URL (required) ----------------------------------------------
# Base URL of the FastAPI backend. All API calls are prefixed with `/api`.
# Local dev: http://localhost:8001
REACT_APP_BACKEND_URL=http://localhost:8001

# --- CRA dev-server hints (Emergent-only, optional) -----------------------
# Only needed when running behind the Emergent Kubernetes ingress. Safe to
# omit locally.
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
