# LUNAVIA — Backend environment (example).
# Copy this file to `backend/.env` and fill in real values.

# --- MongoDB (required) ---------------------------------------------------
# Local dev: mongodb://localhost:27017
MONGO_URL=mongodb://localhost:27017
DB_NAME=lunavia

# --- CORS (required) ------------------------------------------------------
# Comma-separated origins, or "*" for dev.
CORS_ORIGINS=*

# --- Claude Sonnet 5 briefing stream (optional) ---------------------------
# Powers POST /api/mission/briefing (SSE flight-director voice).
# On the Emergent platform this is provided as the Universal LLM key.
# Off-platform, replace `emergentintegrations` with the vendor SDK of your
# choice (Anthropic Claude, OpenAI, Gemini) — see HANDOFF.md §9.
EMERGENT_LLM_KEY=
